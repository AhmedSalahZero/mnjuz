          "name": "get support tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/support-tickets?page=1&per_page=10",
              "host": [
                "{{base_url}}"
