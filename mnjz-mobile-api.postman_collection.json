                "{{support_ticket_uuid}}"
              ]
            },
            "description": "**Who**: the ticket owner — 404 for anyone else's ticket.\n\nAdds `comments`, each with `user.is_me` so you can align the bubble without comparing ids.\n\nOpening a ticket marks its comments as read; no separate call is needed."
          }
        },
        {
          "name": "create support ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/support-tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
